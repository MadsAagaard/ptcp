params {
    rundir = "${launchDir.baseName}"
    genome = 'hg38'          // PTCP supports hg38 only in this implementation
}

// Same shared config as the germline pipeline. T2T is deliberately absent:
// the PTCP meta files (TRGT panel, Paraphase config, ptcp-qc BED, variant list)
// exist for GRCh37/GRCh38 only.
def sharedConfigs = [
    hg38 : '/data/configs/nextflowLRS_refactor_v1.config',
]

def sharedConfigPath = sharedConfigs[ params.genome ]

if (!sharedConfigPath) {
    throw new IllegalArgumentException(
        "Unknown --genome '${params.genome}'. Supported for PTCP: ${sharedConfigs.keySet().join(', ')}")
}

if (!new File(sharedConfigPath).exists()) {
    throw new IllegalStateException(
        "Shared config for --genome ${params.genome} not found at ${sharedConfigPath}")
}

includeConfig sharedConfigPath
includeConfig 'conf/ptcp.config'
