/*
 * =============================================================================
 * KG Vejle — PacBio PureTarget Carrier Panel (PTCP), local implementation
 * PTCP-specific additions on top of the shared LRS config
 * =============================================================================
 *
 * Everything shared with the germline pipeline (reference genome, roots,
 * labels, slurm profile, error strategy, condaEnvs) comes from
 * nextflowLRS_refactor_v1.config.
 *
 * This file adds what PTCP needs and the shared config does not have:
 *   - two conda envs (condaEnvs.ptcp, condaEnvs.sawfish221)
 *   - where the PTCP scripts and reference files are in the lrsCustomTools release
 *     (ptcp/pacbio/ and resources/ptcp/, vendored unmodified from PacBio PTCP)
 *   - the PureTarget uBAM archive, sample sheet name handling and output layout
 *   - a few PTCP run parameters
 *
 * Tool versions vs. PTCP v3.2.1 (PacBio's validated set):
 *   pbmm2      condaEnvs.pbmm2       1.16.99 (26.1.99 with --latestVersions)  PTCP: SMRT Link 25.1
 *   TRGT       condaEnvs.trgt51      5.1.0                                    PTCP: 5.0.0
 *              (5.1.0 is the first version with --fail-reads)
 *   Paraphase  condaEnvs.paraphase35 3.5.0                                    PTCP: 3.4.0
 *   Sawfish    condaEnvs.sawfish221  2.2.1                                    PTCP: 2.2.1
 *   ptcp-qc, pbindex, minimap2 and the Python packages the PTCP scripts
 *   need: condaEnvs.ptcp, built by env/build_ptcp_env.sh
 *   PTCP scripts (f8_inversion.py, havanno, smn_homology, ptcpqc_json_to_csv.py):
 *   lrsCustomTools ptcp/pacbio/, run as python3 <path> in the step's env
 *   samtools, bcftools: from PATH, as in the germline pipeline
 * =============================================================================
 */

// -----------------------------------------------------------------------------
// lrsCustomTools release: PTCP scripts and reference files
// -----------------------------------------------------------------------------
// params.lrsCustomToolsBase comes from the shared config (releases/current,
// resolved at launch), the same base the germline custom scripts use.
// --lrsCustomToolsBase <folder> on the command line runs against another
// checkout instead, e.g. a 'lrsCustomToolsPull.sh test' folder.
params {

    ptcpVersion          = '3.2.1'      // PacBio PTCP release the scripts and resources come from
    ptcpScripts          = "${params.lrsCustomToolsBase}/ptcp/pacbio"
    ptcpResources        = "${params.lrsCustomToolsBase}/resources/ptcp/v${params.ptcpVersion}"

    // ---- Conda envs not in the shared config (same naming scheme) ----------
    // Candidates for the shared config's condaEnvs block. condaEnvs.sawfish2
    // there is 2.1.1 unless --latestVersions; PTCP 3.2.1 uses 2.2.1.
    condaEnvs {
        ptcp       = "${params.condaLocal}/ptcp/"          // env/build_ptcp_env.sh
        sawfish221 = "${params.condaLocal}/sawfish_221/"
    }

    // ---- PTCP reference files (GRCh38), lrsCustomTools resources/ptcp/ -----
    ptcpTrgtBed          = "${params.ptcpResources}/trgt/PureTarget_repeat_expansion_panel_2.0.repeat_definition.GRCh38.bed"
    ptcpParaphaseConfig  = "${params.ptcpResources}/paraphase/paraphase_config.GRCh38.yaml"
    ptcpVariantList      = "${params.ptcpResources}/variant_list/variant_list.GRCh38.vcf"   // havanno; set null to skip
    ptcpQcBed            = "${params.ptcpResources}/ptcp-qc/ptcp-qc.GRCh38.bed"
    ptcpSmnRegression    = null      // optional SMN1/2 homology model (JSON); null = correction skipped

    // ---- Run parameters (values as in the PTCP WDL) -------------------------
    ptcpGenomeVersion    = '38'                     // Paraphase / f8_inversion.py --genome
    ptcpHbaRegion        = 'chr16:126123-209491'    // sawfish.wdl, GRCh38 HBA region
    ptcpRepeatPad        = 3000                     // trgt.wdl get_reads_overlapping_repeats expand_size
    ptcpLogLevel         = 'INFO'                   // pbmm2 --log-level

    // ---- Input --------------------------------------------------------------
    // PureTarget runs are archived here by pacbio_sync_and_rename.sh puretarget
    // (<runLabel>_<RUN_NAME>/hifi_reads/ and failed_reads/), not in the germline
    // rawData archive (params.dataArchive). --input searches another folder.
    ptcpDataArchive      = '/lnx01_data2/shared/dataArchive/lnx02_v2/pacBioLRS/pureTarget_rawdata/'
    // Only uBAMs whose file name testlist starts with this text are used, and
    // each sample sheet row takes only the uBAMs with its own NPN + testlist,
    // so WGS uBAMs and other PureTarget tests of the same NPN never enter.
    // Compared with '_' as '-' and a leading 'SL-' dropped: LabWare has
    // SL-PT-KENDT, the SMRT Link sample name (and so the uBAM) has PT-KENDT.
    // Wide on purpose until the lab settles on a PureTarget testlist name.
    ptcpTestlist         = 'PT'
    // The shared minHifiGB (35 GB) is a WGS gate and would drop every PureTarget
    // sample. PTCP uses its own gate; 0 = keep everything.
    ptcpMinGB            = 0

    // ---- Reports (lrsCustomTools summaryScripts/ptcp/) ----------------------
    // Per-sample report + run QC report. Missing files only disable the
    // reports (warning at launch); they never stop the analysis.
    ptcpReports          = true
    ptcpReportScripts    = "${params.lrsCustomToolsBase}/summaryScripts/ptcp"
    ptcpReportThresholds = null     // YAML/JSON with approved_by + approved_date; null = placeholders
    // Lab target-share reference (report/ptcp_build_reference.py on validation
    // samples). null = compare each sample with the other samples of its own
    // SMRT Cell (leave-one-out, needs >= 5 of them), else no comparison.
    ptcpReportReference  = null
    // Versions shown in the reports against PacBio's PTCP 3.2.1 set. CONFIGURED,
    // not probed: keep in step with the conda envs above.
    ptcpToolVersions     = [
        [tool: 'pbmm2',     version: params.latestVersions ? '26.1.99' : '1.16.99', ptcp: 'SMRT Link 25.1'],
        [tool: 'TRGT',      version: '5.1.0', ptcp: '5.0.0'],
        [tool: 'Paraphase', version: '3.5.0', ptcp: '3.4.0'],
        [tool: 'Sawfish',   version: '2.2.1', ptcp: '2.2.1'],
        [tool: 'ptcp-qc',   version: '1.0.0', ptcp: '1.0.0'],
    ]
}


// -----------------------------------------------------------------------------
// Sample sheet name and output layout
// -----------------------------------------------------------------------------
// The shared config strips only '.txt' from the sample sheet name; a SMRT Link
// sheet is a '.csv'. Strip both, so runInfo folders and report names never end
// in '.csv'.
def ptcpDateTag   = new Date().format('yyMMdd')
def ptcpTraceTag  = new Date().format('yyyy-MM-dd_HH-mm-ss')
def ptcpSsBase    = params.samplesheet
    ? params.samplesheet.toString().tokenize('/').last().replaceFirst(/\.(txt|csv)$/, '')
    : 'NoSampleSheet'

params.ssBase = ptcpSsBase

def ptcpReportDir = "${params.outputDirBase}/runInfo/${ptcpDateTag}_${ptcpSsBase}/NextflowReports"
timeline { enabled = true; file = "${ptcpReportDir}/${ptcpSsBase}.${ptcpTraceTag}.Nextflow_timeline.html" }
report   { enabled = true; file = "${ptcpReportDir}/${ptcpSsBase}.${ptcpTraceTag}.Nextflow_report.html" }
trace    { enabled = true; file = "${ptcpReportDir}/${ptcpSsBase}.${ptcpTraceTag}.Nextflow_trace.txt" }
dag      { enabled = true; file = "${ptcpReportDir}/${ptcpSsBase}.${ptcpTraceTag}.Nextflow_dag.html"; overwrite = true }

// Output is aggregated per run, as in the pureTarget pipeline: one folder per
// sample sheet, and in it one subfolder per output type holding every sample
// (alignments/, repeatExpansions/TRGT/, specialAnalysis/paraphase/, ...).
// Sample identity is carried by the file names (<npn>.hg38v4LRS.<tag>...),
// which are unique per sample: the sheet is deduplicated on NPN at launch.
//   <outputDirBase>/pureTargetCarrier/<sample sheet>_<readSet>[_latestToolVersions]/
//
// params.outBase keeps the germline signature (a closure on meta), so every
// publishDir reads ${params.outBase(meta)} as in the germline modules; here it
// returns the same run folder for every sample. Run-level steps (ptcp-qc) use
// params.runOutBase directly.
params.runOutBase = "${params.outputDirBase}/pureTargetCarrier/${ptcpSsBase}_${params.readSet}${params.toolsVersion}"
params.outBase    = { meta -> params.runOutBase }


// -----------------------------------------------------------------------------
// Process overrides
// -----------------------------------------------------------------------------
process {

    // The slurm profile sets shell = ['/bin/bash', '-l'], which keeps going after
    // a failed command (only the last command's exit status counts). For every
    // process of this pipeline, keep the login shell but stop on the first
    // error, and fail a pipe if any part fails (the HBA step pipes
    // samtools -> minimap2 -> samtools; PTCP runs it with set -euo pipefail).
    // -u is left out: with -l it trips over unset variables in /etc/profile.d.
    // withName beats the generic profile setting, so this wins on slurm too.
    withName: '.*' {
        shell = ['/bin/bash', '-l', '-eo', 'pipefail']
    }
}
