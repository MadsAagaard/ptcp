/*
 * =============================================================================
 * pacbioPTCP/conf/ptcp.config — pipeline config (between lrsShared.config and finalize.config)
 * PacBio PureTarget Carrier Panel (PTCP), local implementation.
 * Shared values come from lrsShared.config.
 * =============================================================================
 * Before the split, PTCP loaded the whole germline config and inherited the
 * germline naming tags and output root from it. It no longer does, so the few
 * germline values PTCP uses are set here, with the germline values.
 *
 * Output root (decided 23 Oct), next to pureTarget:
 *   /lnx01_data2/shared/patients/pacbioLRS/<genome>/<year>/pureTargetPTCP/
 *       <sheet>_<readSet>[_latestToolVersions]/     one folder per run, all samples
 *       runInfo/<yyMMdd>_<sheet>/                    summaries, Nextflow reports, FAILED_TASKS
 * (was /lnx01_data3/pacBioAnalyzedSamples/<genome>/<year>/pureTargetCarrier/<sheet>_<readSet>/)
 *
 * Other changes from pacbioPTCP_v1/conf/ptcp.config:
 *   - ptcpDataArchive -> dataArchive (the per-pipeline canonical name)
 *   - timeline/report/trace/dag removed: finalize.config writes the same files
 *     and now strips '.csv' from the sheet name for every pipeline
 * =============================================================================
 */


// -----------------------------------------------------------------------------
// Germline values PTCP uses (naming tags, output root). Same values as germline.
// -----------------------------------------------------------------------------
params {
    // Germline flags PTCP rejects at launch (main.nf). Defined so the check
    // reads null instead of an undefined param.
    failedReads  = null
    aligned      = null
    allReads     = null
    customSS     = null
    jointSS      = null
    familySS     = null
    jointCall    = null
    hpo          = null
    singleOnly   = null
    intrefOnly   = null

    readSet      = params.hifiReads ? 'hifiReads' : 'AllAndHifi'
    inputReadSet = params.hifiReads ? 'HifiReads' : 'HifiAndFail'
    tagHifi      = 'HifiReads'
    tagFail      = 'failedReads'
    strTag       = params.hifiReads ? 'HifiReadsOnly' : 'AllReadsNew'
    toolsVersion = params.latestVersions ? '_latestToolVersions' : ''
}

// Output root (HANDOFF open item 6, decided 23 Oct). --outdir <x> replaces it
// with <x>_<readSet>, as before.
params.outputDirBase = params.outdir
    ? "${params.outdir}_${params.readSet}"
    : "${params.patientsLrsRoot}/${params.genome}/${params.yearStamp}/pureTargetPTCP"


// -----------------------------------------------------------------------------
// lrsCustomTools release: PTCP scripts and reference files
// -----------------------------------------------------------------------------
params {

    ptcpVersion          = '3.2.1'
    ptcpScripts          = "${params.lrsCustomToolsBase}/ptcp/pacbio"
    ptcpResources        = "${params.lrsCustomToolsBase}/resources/ptcp/v${params.ptcpVersion}"

    condaEnvs {
        ptcp       = "${params.condaLocal}/ptcp/"          // env/build_ptcp_env.sh
        sawfish221 = "${params.condaLocal}/sawfish_221/"
    }

    ptcpTrgtBed          = "${params.ptcpResources}/trgt/PureTarget_repeat_expansion_panel_2.0.repeat_definition.GRCh38.bed"
    ptcpParaphaseConfig  = "${params.ptcpResources}/paraphase/paraphase_config.GRCh38.yaml"
    ptcpVariantList      = "${params.ptcpResources}/variant_list/variant_list.GRCh38.vcf"
    ptcpQcBed            = "${params.ptcpResources}/ptcp-qc/ptcp-qc.GRCh38.bed"
    ptcpSmnRegression    = null

    ptcpGenomeVersion    = '38'
    ptcpHbaRegion        = 'chr16:126123-209491'
    ptcpRepeatPad        = 3000
    ptcpLogLevel         = 'INFO'

    dataArchive          = params.dataArchivePureTarget     // was ptcpDataArchive; shared with pureTarget
    ptcpTestlist         = 'PT'
    ptcpMinGB            = 0

    ptcpReports          = true
    ptcpReportScripts    = "${params.lrsCustomToolsBase}/summaryScripts/ptcp"
    ptcpReportThresholds = null
    ptcpReportReference  = null
    ptcpToolVersions     = [
        [tool: 'pbmm2',     version: params.latestVersions ? '26.1.99' : '1.16.99', ptcp: 'SMRT Link 25.1'],
        [tool: 'TRGT',      version: '5.1.0', ptcp: '5.0.0'],
        [tool: 'Paraphase', version: '3.5.0', ptcp: '3.4.0'],
        [tool: 'Sawfish',   version: '2.2.1', ptcp: '2.2.1'],
        [tool: 'ptcp-qc',   version: '1.0.0', ptcp: '1.0.0'],
    ]
}


// -----------------------------------------------------------------------------
// Sample sheet name and run-aggregated output layout (unchanged)
// -----------------------------------------------------------------------------
// ssBase is set here (not left to finalize.config) because runOutBase needs it now.
params.ssBase = params.samplesheet
    ? params.samplesheet.toString().tokenize('/').last().replaceFirst(/\.(txt|csv)$/, '')
    : 'NoSampleSheet'

params.runOutBase = "${params.outputDirBase}/${params.ssBase}_${params.readSet}${params.toolsVersion}"
params.outBase    = { meta -> params.runOutBase }


// -----------------------------------------------------------------------------
// Process overrides
// -----------------------------------------------------------------------------
process {
    // bash -l keeps going after a failed command; stop on the first error and
    // fail a pipe if any part fails. -u left out (trips over /etc/profile.d).
    withName: '.*' {
        shell = ['/bin/bash', '-l', '-eo', 'pipefail']
    }
}

// Inherited from the germline config before the split (same process names);
// kept so the fail-read alignment is sized as before.
profiles {
    slurm {
        process {
            withName: 'pbmm2_align_failedOnly' { cpus = 32; memory = '32 GB'; time = '24h' }
            withName: 'pbmm2_align_hifi'       { cpus = 64; memory = '64 GB'; time = '72h' }
        }
    }
}
